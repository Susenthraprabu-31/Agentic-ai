# Application
APP_NAME="Title Search Platform"
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/titledb

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-generate-a-real-secret-key

# OpenAI (Phase 2)
OPENAI_API_KEY=

# Mistral (Phase 2)
MISTRAL_API_KEY=

# S3 (Phase 2)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=titlemvp
