# ─────────────────────────────────────────────────────────────────────────────
# Title Search Platform — Root Environment Template
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=dono_user
POSTGRES_PASSWORD=193034
POSTGRES_DB=dono_db
POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_PORT=8000

# Constructed from above — used inside containers
DATABASE_URL=postgresql+psycopg://dono_user:193034@127.0.0.1:5432/dono_db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Application
APP_NAME="Title Search Platform"
ENVIRONMENT=development
DEBUG=true

# Security — CHANGE THIS before deploying
# Generate with: openssl rand -hex 32
SECRET_KEY=6159121f4a54e0395ed8f7bd8a52978a9556d5a49e667503ad9d6dc891f4d3c1

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=/api/v1

# ─── AI / OCR (Phase 2) ───────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
MISTRAL_API_KEY=

# ─── Playwright Browser Automation & Visible Mode ─────────────────────────────
PLAYWRIGHT_ENABLED=true
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOW_MO_MS=300
PLAYWRIGHT_KEEP_BROWSER_OPEN_SECONDS=5
PLAYWRIGHT_BROWSER_MODE=local_visible

# ─── S3-Compatible Storage (Phase 2) ─────────────────────────────────────────
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=titlemvp

# ─── Resilience & Retry Engine (Phase 3D.1) ──────────────────────────────────
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=60.0
RETRY_EXPONENTIAL_BASE=2.0
RETRY_JITTER_ENABLED=true
RETRY_MAX_DURATION_SECONDS=300.0

# ─── Worker Recovery & Circuit Breakers (Phase 3D.3) ─────────────────────────
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_TIMEOUT_SECONDS=60
WORKER_MONITOR_INTERVAL_SECONDS=20

EXECUTION_STALE_TIMEOUT_SECONDS=300
EXECUTION_MAX_RECOVERY_ATTEMPTS=3
EXECUTION_RECOVERY_INTERVAL_SECONDS=30

CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_WINDOW_SECONDS=120
CIRCUIT_BREAKER_OPEN_SECONDS=60
CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=2
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2

# Browser & Document Download Resilience (Phase 3D.4)
BROWSER_LAUNCH_TIMEOUT_MS=30000
BROWSER_NAVIGATION_TIMEOUT_MS=45000
BROWSER_MAX_PROCESSES_PER_WORKER=2
BROWSER_MAX_CONTEXTS_PER_WORKER=5
BROWSER_MAX_PAGES_PER_EXECUTION=5
BROWSER_CONTEXT_CLEANUP_TIMEOUT_SECONDS=15
BROWSER_MAX_SESSION_LIFETIME_SECONDS=1800

DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=120
DOCUMENT_DOWNLOAD_MAX_SIZE_MB=25
DOCUMENT_DOWNLOAD_CHUNK_SIZE_BYTES=65536
DOCUMENT_DOWNLOAD_MAX_ATTEMPTS=3
DOCUMENT_DOWNLOAD_STALE_TIMEOUT_SECONDS=300

DOCUMENT_TEMP_CLEANUP_INTERVAL_SECONDS=600
DOCUMENT_TEMP_MAX_AGE_HOURS=24
DOCUMENT_TEMP_STORAGE_DIR=tmp/downloads

